# 本机服务端环境示例，复制为 .env.local 后填写；不要提交密钥。
# npm run demo 固定离线；demo:real 需要把 MODEL_PROVIDER 改为 glm 并填写 key。
HOST=127.0.0.1
PORT=3000
DATABASE_URL=file:./data/campus-notice.db
PRIVATE_STORAGE_DIR=./data/uploads
APP_TIMEZONE=Asia/Shanghai
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_NAME=glm-4.5-flash
MODEL_VISION_NAME=glm-4.5v
# 可选：enabled / disabled。普通应用不配置时不发送 thinking 参数。
# demo:real 未明确配置时两项默认 disabled；显式 enabled 会保留。
# MODEL_THINKING=disabled
# MODEL_VISION_THINKING=disabled
MODEL_API_KEY=
MODEL_CALL_TIMEOUT_MS=60000
MODEL_RUN_TIMEOUT_MS=240000
MODEL_MAX_CALLS_PER_RUN=3
MODEL_MAX_OUTPUT_TOKENS=4000
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
SAVE_RAW_MODEL_RESPONSE=false

